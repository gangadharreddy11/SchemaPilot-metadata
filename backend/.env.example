# === Database Connection Examples ===
# 1. Local MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/schemapilot

# 2. Supabase (Use Connection Pooler on port 6543/5432 to avoid IPv6 timeout on Windows):
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Set to * to allow connections from Vercel (https://*.vercel.app), tunnels, and localhost
CORS_ORIGINS=*
